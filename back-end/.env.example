# Copy this file to .env and replace placeholders for local development.
# Process environment variables take precedence over values in this file.
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL connection settings. Use a database account configured on your server.
DB_NAME=cms_db
DB_USER=replace-with-your-local-mysql-user
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=localhost
DB_PORT=3306

# Optional environment-specific settings
CLINIC_TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:8000,http://localhost:5174
